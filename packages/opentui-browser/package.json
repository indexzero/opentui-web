{
  "name": "@indexzero/opentui-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./opentui.wasm": "./dist/opentui.wasm",
    "./kernels/matrix": {
      "types": "./dist/kernels/matrix.d.ts",
      "import": "./dist/kernels/matrix.js"
    },
    "./kernels/fire": {
      "types": "./dist/kernels/fire.d.ts",
      "import": "./dist/kernels/fire.js"
    },
    "./kernels/plasma": {
      "types": "./dist/kernels/plasma.d.ts",
      "import": "./dist/kernels/plasma.js"
    },
    "./kernels/mandelbrot": {
      "types": "./dist/kernels/mandelbrot.d.ts",
      "import": "./dist/kernels/mandelbrot.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@webgpu/types": "^0.1.70",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
